# /etc/security-audit.env
# Настройки для отправки уведомлений через Resend
# Права доступа: chmod 600 /etc/security-audit.env
#
# Получить API ключ: https://resend.com/api-keys
# Домен отправителя должен быть подтверждён в Resend Dashboard

RESEND_API_KEY="re_ВАШ_API_КЛЮЧ"
RESEND_FROM="security@ВАШ_ДОМЕН.com"
RESEND_TO="admin@ВАШ_EMAIL.com"
