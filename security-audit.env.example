# /etc/security-audit.env
# Email notification settings via Resend
# Permissions: chmod 600 /etc/security-audit.env
#
# Get your API key: https://resend.com/api-keys
# The sender domain must be verified in the Resend Dashboard

RESEND_API_KEY="re_YOUR_API_KEY"
RESEND_FROM="security@your-domain.com"
RESEND_TO="admin@your-email.com"
